---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';
export async function getStaticPaths() { const entries = await getCollection('projects'); return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
const project = entry.data;
const externalLinks = project.links ?? (project.link ? [{ label: 'Kunjungi Website', href: project.link }] : []);
const allProjects = (await getCollection('projects')).map((item) => item.data);
const commands = allProjects
  .filter((item) => item.slug !== project.slug)
  .map((item) => ({ label: item.title, href: '/work/' + item.slug + '/', kind: item.category }));
const creativeWorkSchema = { '@context': 'https://schema.org', '@type': 'CreativeWork', name: project.title, headline: project.title, description: project.description, image: new URL(project.image, site.canonical).toString(), url: site.canonical + '/work/' + project.slug + '/', dateCreated: project.year, inLanguage: 'id-ID', genre: project.category, keywords: project.services.join(', '), creator: { '@id': site.canonical + '/#person' } };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: site.canonical }, { '@type': 'ListItem', position: 2, name: 'Karya', item: site.canonical + '/work/' }, { '@type': 'ListItem', position: 3, name: project.title, item: site.canonical + '/work/' + project.slug + '/' }] };
---
<BaseLayout
  title={project.title + ' — Portfolio ' + site.name}
  description={project.description}
  image={project.image}
  imageAlt={'Preview project ' + project.title}
  imageWidth={project.width}
  imageHeight={project.height}
  type="article"
  commands={commands}
  statusRight={project.category + ' · ' + project.year}
>
  <Header />
  <main id="main" class="project-page container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">~</a><span class="sep">/</span><a href="/work/">work</a><span class="sep">/</span><span aria-current="page">{project.slug}</span></nav>
    <p class="eyebrow">{project.category} · {project.year}</p>
    <h1 class="page-title">{project.title}</h1>
    <p class="project-intro">{project.description}</p>

    <div class="win project-hero-frame">
      <div class="win-bar"><span class="dots"><i></i><i></i><i></i></span><span class="win-title">{project.slug}/preview</span></div>
      {project.gallery && project.gallery.length > 1 ? (
        <ProjectGallery images={project.gallery} />
      ) : (
        <img class="project-hero" src={project.image} alt={'Tampilan utama project ' + project.title} width={project.width} height={project.height} />
      )}
    </div>

    <div class="case-study">
      <section><p class="eyebrow">Tantangan</p><h2>{project.challenge}</h2></section>
      <section><p class="eyebrow">Pendekatan</p><p>{project.solution}</p><ul>{project.services.map((service) => <li>{service}</li>)}</ul></section>
    </div>
    <div class="project-body"><Content /></div>
    <div class="project-actions">
      {externalLinks.map((item) => <a class="button button-secondary" href={item.href} target="_blank" rel="noopener noreferrer">{item.label} ↗</a>)}
      <a class="button button-primary" href={'mailto:' + site.email}>Diskusikan project ↗</a>
    </div>
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(creativeWorkSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
