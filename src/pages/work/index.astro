---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
const projects = (await getCollection('projects')).sort((a, b) => Number(b.data.year) - Number(a.data.year)).map((entry) => entry.data);
const commands = projects.map((project) => ({ label: project.title, href: '/work/' + project.slug + '/', kind: project.category }));
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Karya — ' + site.name,
  url: site.canonical + '/work/',
  description: 'Pilihan project web development, UI/UX, branding, dan desain visual Bimo Kharismantoro.',
  inLanguage: 'id-ID',
  isPartOf: { '@id': site.canonical + '/#website' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.title,
      url: site.canonical + '/work/' + project.slug + '/'
    }))
  }
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: site.canonical },
    { '@type': 'ListItem', position: 2, name: 'Karya', item: site.canonical + '/work/' }
  ]
};
---
<BaseLayout
  title="Karya & Portfolio Project — Bimo Kharismantoro"
  description="Pilihan project web development, UI/UX, branding, dan desain visual karya Bimo Kharismantoro."
  commands={commands}
  statusRight={projects.length + ' project · id-ID'}
>
  <Header />
  <main id="main" class="container page-main">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">~</a><span class="sep">/</span><span aria-current="page">work</span></nav>
    <p class="eyebrow">Project archive</p>
    <h1 class="page-title">Karya pilihan.</h1>
    <p class="prompt-line"><span class="prompt">$</span>ls ./projects <span class="flag">--sort</span> year <span class="flag">--count</span> {projects.length}</p>
    <div class="project-grid">
      {projects.map((project, index) => (
        <a class="project-card" data-reveal href={'/work/' + project.slug + '/'}>
          <div class="card-bar"><span class="dots"><i></i><i></i><i></i></span><span class="file">{project.slug}.project</span><span class="go">open →</span></div>
          <div class="project-image"><img src={project.image} alt={'Preview project ' + project.title} width={project.width} height={project.height} loading={index === 0 ? 'eager' : 'lazy'} /></div>
          <div class="project-meta"><div><p class="project-category">{project.category} · {project.year}</p><h2>{project.title}</h2></div><span aria-hidden="true">↗</span></div>
          <p class="project-description">{project.description}</p>
        </a>
      ))}
    </div>
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
