---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Kontak — ' + site.name,
  url: site.canonical + '/contact/',
  inLanguage: 'id-ID',
  isPartOf: { '@id': site.canonical + '/#website' },
  mainEntity: { '@id': site.canonical + '/#person' }
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: site.canonical },
    { '@type': 'ListItem', position: 2, name: 'Kontak', item: site.canonical + '/contact/' }
  ]
};
---
<BaseLayout
  title={'Kontak & Hire — ' + site.name}
  description={'Hubungi ' + site.name + ' untuk web development, UI/UX design, graphic design, dan kebutuhan digital lainnya. Respons dalam 24 jam.'}
  statusRight="contact · id-ID"
>
  <Header />
  <main id="main" class="container page-main">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">~</a><span class="sep">/</span><span aria-current="page">contact</span></nav>
    <p class="eyebrow">Start a conversation</p>
    <h1 class="page-title">Ceritakan ide kamu.</h1>
    <p class="project-intro">Kirim gambaran singkat project, target, dan waktu pengerjaan. Saya akan membalas melalui email, biasanya dalam 24 jam.</p>
    <div class="contact-layout">
      <div class="win" data-reveal>
        <div class="win-bar"><span class="dots"><i></i><i></i><i></i></span><span class="win-title">new-inquiry.form</span><span class="win-badge"><span>ready</span></span></div>
        <div class="win-body">
          <form class="contact-form" action={'https://formsubmit.co/' + site.email} method="POST">
            <input type="hidden" name="_subject" value="Inquiry baru dari maskhar.id" />
            <input type="hidden" name="_next" value={site.canonical + '/thanks/'} />
            <input type="text" name="_honey" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label for="name">Nama</label><input id="name" name="name" type="text" autocomplete="name" required />
            <label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required />
            <label for="service">Kebutuhan</label><select id="service" name="service" required><option value="">Pilih layanan</option><option>Web Development</option><option>UI/UX Design</option><option>Graphic Design</option><option>Digital Solution</option></select>
            <label for="message">Ceritakan project</label><textarea id="message" name="message" rows="7" required></textarea>
            <button class="button button-primary" type="submit">Kirim pesan ↗</button>
          </form>
        </div>
      </div>
      <div class="contact-options" data-reveal>
        <a href={'mailto:' + site.email}><span>Email</span><strong>{site.email}</strong></a>
        <a href={site.whatsapp} target="_blank" rel="noopener noreferrer"><span>WhatsApp</span><strong>{site.phone}</strong></a>
        <div class="contact-social"><span>Social</span><div class="contact-links"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></div></div>
        <div class="contact-social"><span>Lokasi</span><strong style="font:400 .9rem var(--mono);color:var(--muted)">{site.location}</strong></div>
      </div>
    </div>
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
