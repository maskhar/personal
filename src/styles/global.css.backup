@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--bg:#0b0d0f;--surface:#15191d;--text:#f4f7f5;--muted:#9da8a1;--accent:#b8f34a;--line:rgba(255,255,255,.13);font-family:Manrope,system-ui,sans-serif;color:var(--text);background:var(--bg);font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 80% 0%,#1c2b1d 0,transparent 32rem),var(--bg);line-height:1.6}a{color:inherit;text-decoration:none}.container{width:min(1160px,calc(100% - 48px));margin-inline:auto}.site-header{display:flex;align-items:center;justify-content:space-between;width:min(1160px,calc(100% - 48px));margin:auto;padding:28px 0}.brand{font-weight:800;font-size:1.4rem;letter-spacing:-.08em}.brand span,em{color:var(--accent);font-style:normal}.site-header nav{display:flex;align-items:center;gap:28px;font-size:.9rem;color:var(--muted)}.site-header nav a:hover,.contact-links a:hover{color:var(--accent)}.nav-cta{border:1px solid var(--line);border-radius:99px;padding:9px 16px;color:var(--text)}.hero{min-height:78vh;display:flex;flex-direction:column;justify-content:center;padding-block:80px}.eyebrow,.project-category{font:500 .7rem/1.2 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}h1,h2,h3,p{margin-top:0}h1{max-width:950px;margin-block:28px 48px;font-size:clamp(3.5rem,9vw,8.4rem);line-height:.98;letter-spacing:-.09em}h2{max-width:720px;font-size:clamp(2.2rem,5vw,4.8rem);line-height:1.02;letter-spacing:-.07em}.hero-bottom{display:flex;align-items:end;justify-content:space-between;gap:40px}.lede{max-width:440px;color:var(--muted);font-size:1.1rem}.button{display:inline-flex;align-items:center;gap:24px;border-radius:99px;padding:15px 20px;font-weight:700;white-space:nowrap}.button-primary{background:var(--accent);color:#111}.button-primary:hover{background:#d0ff79;transform:translateY(-2px)}.section{padding-block:110px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:52px}.section-heading h2{margin-bottom:0}.project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:48px 24px}.project-card{min-width:0}.project-featured{grid-column:span 2}.project-image{aspect-ratio:16/10;background:var(--surface);overflow:hidden}.project-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}.project-card:hover img{transform:scale(1.04)}.project-meta{display:flex;justify-content:space-between;gap:20px;padding-top:18px}.project-meta h3{font-size:1.5rem;margin:8px 0 0}.project-meta>span{font-size:1.5rem;color:var(--accent)}.project-description{color:var(--muted);max-width:460px;margin-top:8px}.section-muted{background:var(--surface)}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.service-card{padding:24px 20px 12px 0;border-right:1px solid var(--line)}.service-card+ .service-card{padding-left:20px}.service-card:last-child{border-right:0}.service-card span{font:500 .75rem 'DM Mono',monospace;color:var(--accent)}.service-card h3{margin:45px 0 12px;font-size:1.2rem}.service-card p,.about-copy{color:var(--muted)}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.about-copy{font-size:1.2rem;max-width:540px}.contact{padding-block:150px}.contact h2{margin-block:25px 40px}.contact-links{display:flex;gap:24px;margin-top:70px;color:var(--muted);font:500 .8rem 'DM Mono',monospace}.site-footer{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-block:24px;color:var(--muted);font-size:.75rem}.skip-link{position:absolute;left:-9999px}.skip-link:focus{left:16px;top:16px;background:var(--accent);color:#111;padding:12px;z-index:5}@media(max-width:760px){.container,.site-header{width:min(100% - 32px,560px)}.site-header nav a:not(.nav-cta){display:none}.hero{min-height:75vh;padding-block:60px}.hero-bottom,.section-heading{display:block}.hero-bottom .button{margin-top:24px}.section{padding-block:76px}.project-grid{display:block}.project-card,.project-featured{margin-bottom:48px}.service-grid{grid-template-columns:1fr 1fr}.service-card:nth-child(2n){border-right:0;padding-left:20px}.service-card:nth-child(n+3){border-top:1px solid var(--line);padding-top:24px}.about-grid{display:block}.about-copy{margin-top:36px}.contact{padding-block:100px}.site-footer{display:block}.site-footer span+span{display:block;margin-top:8px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition-duration:.01ms!important}}
.page-main{padding-block:90px 130px}.page-title{max-width:900px;margin:24px 0 48px;font-size:clamp(3.5rem,9vw,8rem);line-height:.95;letter-spacing:-.08em}.page-main .project-meta h2{font-size:1.5rem;letter-spacing:-.04em;margin:8px 0 0}.project-page{padding-block:90px 140px}.project-intro{max-width:700px;color:var(--muted);font-size:1.35rem}.project-hero{display:block;width:100%;max-height:760px;object-fit:contain;background:var(--surface);margin:64px 0 100px}.case-study{display:grid;grid-template-columns:1.25fr .75fr;gap:80px;margin-bottom:80px}.case-study h2{font-size:clamp(2rem,4vw,3.8rem)}.case-study section>p:not(.eyebrow),.case-study li{color:var(--muted)}.case-study ul{padding:20px 0 0;list-style:none;border-top:1px solid var(--line)}.case-study li{padding:10px 0;border-bottom:1px solid var(--line)}.contact-options{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:70px}.contact-options a{display:flex;flex-direction:column;gap:14px;padding:28px;background:var(--surface);border:1px solid var(--line)}.contact-options span{font:500 .7rem DM Mono,monospace;text-transform:uppercase;color:var(--accent)}.contact-options strong{font-size:clamp(1rem,2.5vw,1.6rem);overflow-wrap:anywhere}@media(max-width:760px){.page-main,.project-page{padding-block:60px 100px}.case-study,.contact-options{grid-template-columns:1fr}.project-hero{margin:42px 0 70px}.case-study{gap:30px}}
.breadcrumbs{display:flex;gap:10px;color:var(--muted);font:500 .7rem DM Mono,monospace;margin-bottom:45px}.breadcrumbs a:hover{color:var(--accent)}.breadcrumbs span:last-child{color:var(--text)}
.contact-layout{display:grid;grid-template-columns:1.2fr .8fr;gap:56px;margin-top:70px}.contact-form{display:grid;gap:12px}.contact-form label{font:500 .72rem DM Mono,monospace;text-transform:uppercase;color:var(--muted);margin-top:10px}.contact-form input,.contact-form select,.contact-form textarea{width:100%;border:1px solid var(--line);background:var(--surface);color:var(--text);padding:15px;font:inherit;border-radius:0}.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{outline:2px solid var(--accent);outline-offset:2px}.contact-form button{border:0;margin-top:18px;justify-self:start;cursor:pointer}.honeypot{position:absolute!important;left:-9999px!important}.contact-layout .contact-options{display:flex;flex-direction:column;margin-top:0}.status-page{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:flex-start}.status-page h1{margin:20px 0}.status-page p{color:var(--muted);font-size:1.2rem}@media(max-width:760px){.contact-layout{grid-template-columns:1fr;gap:42px}}
.project-body{max-width:700px;color:var(--muted);font-size:1.1rem;margin:0 0 50px}.project-body p{margin-bottom:0}
.status-page h1{font-size:clamp(3rem,8vw,7rem);line-height:1;letter-spacing:-.08em;max-width:900px}
.menu-toggle{display:none;background:none;border:1px solid var(--line);color:var(--text);padding:9px 14px;font:500 .7rem DM Mono,monospace;text-transform:uppercase}.filter-list{display:flex;gap:10px;margin:-25px 0 35px}.filter-button{border:1px solid var(--line);background:transparent;color:var(--muted);padding:9px 14px;font:500 .7rem DM Mono,monospace;cursor:pointer}.filter-button.is-active,.filter-button:hover{background:var(--accent);border-color:var(--accent);color:#111}.project-card[hidden]{display:none}.button-secondary{border:1px solid var(--line);color:var(--text)}.contact-actions{display:flex;gap:12px;flex-wrap:wrap}.resume-page{padding-block:70px 130px}.resume-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;padding-bottom:60px;border-bottom:1px solid var(--line)}.resume-heading .page-title{margin-bottom:20px}.resume-section{display:grid;grid-template-columns:220px 1fr;gap:30px;padding:42px 0;border-bottom:1px solid var(--line)}.resume-section>p:not(.eyebrow){max-width:650px;color:var(--muted);font-size:1.15rem}.resume-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.resume-grid h2{font-size:1.25rem;letter-spacing:-.03em}.resume-grid p{color:var(--muted)}@media(max-width:760px){.menu-toggle{display:block}.site-header nav{display:none}.site-header nav.is-open{display:flex;position:absolute;top:78px;left:16px;right:16px;z-index:2;flex-direction:column;align-items:stretch;padding:18px;background:var(--surface);border:1px solid var(--line)}.site-header nav.is-open a{display:block;padding:10px}.filter-list{overflow:auto}.resume-heading,.resume-section{display:block}.resume-heading .button{margin-top:24px}.resume-section .eyebrow{margin-bottom:20px}.resume-grid{grid-template-columns:1fr}}@media print{body{background:#fff;color:#111}.print-hidden{display:none!important}.resume-page{padding:0}.resume-page .eyebrow{color:#506b18}.resume-section{border-color:#ddd}.resume-section>p:not(.eyebrow),.resume-grid p{color:#333}.resume-page a{color:#111}}

