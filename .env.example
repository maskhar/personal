# =========================================================
#  maskhar.id — environment variables
#  Salin file ini jadi `.env` lalu isi nilainya.
#  Semua variabel PUBLIC_* ikut ter-bundle ke HTML statis.
#  Kalau variabel dikosongkan, script-nya tidak dirender sama sekali.
# =========================================================

# --- Google Analytics 4 -----------------------------------
# Ambil di: analytics.google.com > Admin > Data Streams > Web
# Format: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# --- Umami (analytics alternatif, opsional) ---------------
# Ambil di: dashboard Umami > Settings > Websites > Edit
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=